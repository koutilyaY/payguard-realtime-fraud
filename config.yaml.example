kafka:
  bootstrap_servers: 127.0.0.1:9092
  topic_raw: txns
  topic_dlq: txns_dead_letter
  topic_alerts: txns_alerts
paths:
  bronze: delta/bronze/txns_v1
  silver: delta/silver/txns_clean_v1
  gold_features: delta/gold/txn_risk_scored_v1
  dq_results: delta/gold/dq_results_v1
  dlq_delta: delta/bronze/dead_letter_v1
  checkpoints: delta/_checkpoints_v1
data:
  csv: data/creditcard.csv
streaming:
  trigger: 2 seconds
  watermark: 5 minutes
  window: 1 minute
rules:
  # Fallback alert threshold; the stream normally uses the model's baked-in 0.5.
  risk_threshold_alert: 0.5
  max_amount: 50000
redis:
  host: localhost
  port: 6379
  ttl_seconds: 86400
postgres:
  host: 127.0.0.1
  port: 5433
  db: payguard
  user: payguard
  password: CHANGE_ME
producer:
  sleep_seconds: 0.01
